GHCR_USER=mazaiguo
GHCR_TOKEN=your_github_personal_access_token_here

# Docker image tag to deploy (ghcr.io/mazaiguo/mdeditor:<tag>).
# "latest" tracks every push to main; pin a release tag like "1.0.3"
# or a build tag like "1.0.3-a1b2c3d" to lock or roll back a deployment.
IMAGE_TAG=latest

# Optional: restrict image serving (/api/local-image) and saving (/api/save-image)
# to a single directory. Used by server.mjs and the Vite dev server middleware.
# IMAGE_ROOT=/path/to/images

